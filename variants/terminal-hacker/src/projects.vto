---
layout: layouts/base.vto
title: Projects - Marwan Ayman Shawky
description: Cloud & DevOps projects showcasing infrastructure automation and CI/CD pipelines
---

<div class="container">
  <section class="section">
    {{ comp.back_link() }}

    {{ comp.page_header({ title: "Projects" }) }}
    <p
      class="page-sub">Infrastructure I've built, broken, and written down afterwards.</p>

    <div class="projects-grid" id="pagination-container">
      {{ for project of projects }}
      <div class="card project-card" data-pagination-item>
        <div class="project-header">
          <h2 class="project-title">
            {{ if project.link }}
            <a href="{{ project.link }}" target="_blank" rel="noopener noreferrer">{{ project.title }}</a>
            {{ else }}
            {{ project.title }}
            {{ /if }}
          </h2>
          <span class="project-meta">{{ project.role }} · {{ project.period }}</span>
        </div>
        
        <p class="project-summary">{{ project.summary }}</p>
        
        {{ if project.highlights }}
        <details class="highlights" name="project-highlights">
          <summary class="highlights-title">Highlights ({{ project.highlights.length }})</summary>
          <ul class="dash-list project-highlights">
            {{ for highlight of project.highlights }}
            <li>{{ highlight }}</li>
            {{ /for }}
          </ul>
        </details>
        {{ /if }}
        
        {{ comp.tech_tags({ tags: project.tech }) }}
      </div>
      {{ /for }}
    </div>
  </section>
</div>
