#!/bin/sh

set -e

staged_files=$(git diff --cached --name-only)

if [ -z "$staged_files" ]; then
  exit 0
fi

for file in $staged_files; do
  case "$file" in
    resume.json|main.typ|_cache/*|_cache/*/*|_cache/*/*/*)
      printf "Blocked: %s must not be committed.\n" "$file" >&2
      printf "Remove it from the index: git restore --staged %s\n" "$file" >&2
      exit 1
      ;;
  esac
done

# Keep the CSP hashes in sync with their sources. Both hashes cover
# bytes proven identical to dev and prod build output:
# - theme script: src/assets/theme-flash.js minus its one trailing
#   newline (the inline plugin strips it);
# - speculation rules: the <script type="speculationrules"> body in
#   src/_includes/partials/head-prefetch.vto, byte for byte.
# Re-stage vercel.json.
staged_theme=0
staged_spec=0
case "$staged_files" in
  *src/assets/theme-flash.js*) staged_theme=1 ;;
esac
case "$staged_files" in
  *src/_includes/partials/head-prefetch.vto*) staged_spec=1 ;;
esac
if [ "$staged_theme" -eq 1 ] || [ "$staged_spec" -eq 1 ]; then
  python3 - "$staged_theme" "$staged_spec" <<'EOF'
import hashlib, base64, re, sys
# (slot, value); slots follow vercel.json order: 0 = theme, 1 = speculation.
digests = []
if sys.argv[1] == "1":
    d = open("src/assets/theme-flash.js", "rb").read()
    d = d[:-1] if d.endswith(b"\n") else d
    digests.append((0, base64.b64encode(hashlib.sha256(d).digest()).decode()))
if sys.argv[2] == "1":
    src = open("src/_includes/partials/head-prefetch.vto").read()
    body = re.search(r'<script type="speculationrules">(.*?)</script>', src, re.S).group(1)
    digests.append((1, base64.b64encode(hashlib.sha256(body.encode()).digest()).decode()))
text = open("vercel.json").read()
for slot, value in digests:
    at = [m.start() for m in re.finditer(r"sha256-[A-Za-z0-9+/=]*", text)][slot]
    end = at + len(re.match(r"sha256-[A-Za-z0-9+/=]*", text[at:]).group(0))
    text = text[:at] + "sha256-" + value + text[end:]
open("vercel.json", "w").write(text)
EOF
  git add vercel.json
fi

format_files=""
lint_files=""
for file in $staged_files; do
  case "$file" in
    src/*.vto|src/*.css|src/*.js|src/*.ts|_config.ts)
      if [ -f "$file" ]; then
        format_files="$format_files $file"
      fi
      ;;
  esac
  case "$file" in
    src/*.js|src/*.ts|_config.ts|scripts/*.js|scripts/*.ts)
      if [ -f "$file" ]; then
        lint_files="$lint_files $file"
      fi
      ;;
  esac
done

if [ -n "$format_files" ]; then
  deno fmt $format_files
  git add $format_files
fi

if [ -n "$lint_files" ]; then
  deno lint $lint_files
fi
