#!/bin/sh

set -e

staged_files=$(git diff --cached --name-only)

if [ -z "$staged_files" ]; then
  exit 0
fi

for file in $staged_files; do
  case "$file" in
    resume.json|main.typ|_cache/*|_cache/*/*|_cache/*/*/*)
      printf "Blocked: %s must not be committed.\n" "$file" >&2
      printf "Remove it from the index: git restore --staged %s\n" "$file" >&2
      exit 1
      ;;
  esac
done

# Keep the CSP sha256 for the inlined theme script in sync with its source.
# The inline plugin strips one trailing newline, so hash the file minus it —
# proven identical to dev and prod build output. Re-stage vercel.json.
case "$staged_files" in
  *src/assets/theme-flash.js*)
    theme_hash=$(python3 -c "import hashlib,base64; d=open('src/assets/theme-flash.js','rb').read(); d=d[:-1] if d.endswith(b'\n') else d; print(base64.b64encode(hashlib.sha256(d).digest()).decode())")
    sed -i "s|sha256-[A-Za-z0-9+/=]*|sha256-${theme_hash}|" vercel.json
    git add vercel.json
    ;;
esac

format_files=""
lint_files=""
for file in $staged_files; do
  case "$file" in
    src/*.vto|src/*.css|src/*.js|src/*.ts|_config.ts)
      if [ -f "$file" ]; then
        format_files="$format_files $file"
      fi
      ;;
  esac
  case "$file" in
    src/*.js|src/*.ts|_config.ts|scripts/*.js|scripts/*.ts)
      if [ -f "$file" ]; then
        lint_files="$lint_files $file"
      fi
      ;;
  esac
done

if [ -n "$format_files" ]; then
  deno fmt $format_files
  git add $format_files
fi

if [ -n "$lint_files" ]; then
  deno lint $lint_files
fi
