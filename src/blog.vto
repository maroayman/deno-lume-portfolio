---
layout: layouts/base.vto
title: Blog - Marwan Ayman Shawky
description: Technical articles about Cloud, DevOps, Infrastructure, and Software Engineering
---

<!-- Instant read indicator + FOUC guards — external file for CSP compliance
     (script-src 'self' blocks inline execution). Runs synchronously before cards paint. -->
<script src="/assets/blog-head.js"></script>

<!-- Hide cards until read status is applied, then reveal (progressive enhancement) -->
<!-- Hide cards until read status is applied, then reveal (progressive enhancement).
     Styles are allowed by style-src 'unsafe-inline'; scripts live in blog-head.js. -->
<style>
.blog-card {
  opacity: 1;
}
</style>
<style>
.js .blog-card {
  opacity: 0;
}
</style>
<noscript><style>.blog-card{opacity:1 !important}</style></noscript>

<div class="container">
  <section class="section">
    {{ comp.back_link() }}

    {{ comp.page_header({ title: "Blog", ar: "المدونة" }) }}

    <p class="page-sub">
      Technical articles about cloud infrastructure, DevOps practices, and lessons learned.
    </p>

    {{# Data preparation lives in TypeScript (plugins/blog-data.ts,
       exposed as Vento filters in _config.ts). This template only
       orchestrates: search UI + view tabs + tag filters + card grid.
       NOTE: the two search calls below intentionally return different
       sets (Lume caches per query string; see plugins/blog-data.ts):
       - ordered query -> the 18 posts (card grid + tag counts),
       - unordered query -> all 37 type=post pages, i.e. posts plus the
         generated tag pages (the "All" total). Do not merge them. #}}
    {{ set posts = search.pages("type=post", "date=desc") |> sortPosts }}
    {{ set allTypePosts = search.pages("type=post") }}
    {{ set totalPosts = allTypePosts.length }}
    {{ set counts = allTypePosts |> tagCounts }}

    <!-- Search and Filter -->
    <div class="blog-search-container">
      {{ comp.blog_search() }}

      {{ comp.blog_view_tabs() }}

      {{ comp.blog_tag_filters({ counts: counts, total: totalPosts }) }}
    </div>

    <div class="blog-result-count" id="resultCount" style="display: none;"
      role="status" aria-live="polite" aria-atomic="true">
      <span id="resultCountText"></span>
    </div>

    <div class="blog-no-results" id="noResults" style="display: none;"
      role="status" aria-live="polite">
      <p>No posts found matching your search.</p>
    </div>

    <div class="blog-grid" id="pagination-container">
      {{ for post of posts }}
      {{ include "partials/blog-card.vto" { post, paginationItem: true, showBookmark: true } }}
      {{ /for }}
    </div>

    <!-- Pagination Controls -->
    <nav aria-label="Blog pagination">
      <div id="pagination-controls" class="pagination"></div>
    </nav>
  </section>
</div>

<script src="/assets/blog-list.js" defer></script>
