---
layout: layouts/base.vto
title: Marwan Ayman Shawky - Cloud & DevOps Engineer
description: Cloud & DevOps Engineer passionate about building scalable infrastructure and automating everything
---

{{ set posts = search.pages("type=post", "date=desc") |> sortPosts }}

<h1>Marwan Ayman Shawky</h1>
<p
  class="in">Cloud &amp; DevOps Engineer in Cairo, Egypt, focused on infrastructure automation, GitOps, and reliable systems.</p>
<div class="k">
  <a
    href="https://github.com/maroayman">{{ comp.icon({ name: "rail-github" }) }}GitHub</a>
  <a
    href="https://gitlab.com/maroayman">{{ comp.icon({ name: "rail-gitlab" }) }}GitLab</a>
  <a
    href="https://linkedin.com/in/maroayman">{{ comp.icon({ name: "rail-linkedin" }) }}LinkedIn</a>
  <a
    href="mailto:marwanayman.shawky@gmail.com">{{ comp.icon({ name: "rail-mail" }) }}Email</a>
  <a
    class="solid"
    href="/resume.pdf">{{ comp.icon({ name: "download", cls: "i" }) }}Resume</a>
</div>

<article class="e" style="margin-top:32px">
  <div>
    <div class="m">About</div>
    <div class="t">DevOps Engineer in Cairo</div>
    <div
      class="m">Hands-on experience building GitOps CI/CD pipelines, automating cloud infrastructure with Terraform, and deploying Kubernetes clusters on AWS and on-premises. Focused on reliable, scalable systems and infrastructure as code.</div>
  </div>
</article>

<article class="e">
  <div>
    <div class="m">Education</div>
    <div class="t">BSc in Computer Science</div>
    <div class="m">Helwan University, Cairo</div>
  </div>
  <div class="d">2018 – 2023</div>
</article>

{{ for job of experience.slice(0, 1) }}
<article class="e">
  <div>
    <div class="m">Latest role</div>
    <div class="t">{{ job.title }}</div>
    <div class="m"><a href="{{ job.companyUrl }}" target="_blank" rel="noopener noreferrer">{{ job.company }}</a> · {{ job.description }}</div>
    {{ comp.tech_tags({ tags: job.tags.slice(0, 5), wrapper: "tg" }) }}
  </div>
  <div class="d">{{ job.period }}</div>
</article>
{{ /for }}

{{ for project of projects.slice(0, 1) }}
<article class="e">
  <div>
    <div class="m">Featured project</div>
    <div class="t">
      {{ if project.link }}
      <a href="{{ project.link }}" target="_blank" rel="noopener noreferrer">{{ project.title }}</a>
      {{ else }}
      {{ project.title }}
      {{ /if }}
    </div>
    <div class="m">{{ project.summary }}</div>
    {{ comp.tech_tags({ tags: project.tech.slice(0, 5), wrapper: "tg" }) }}
  </div>
</article>
{{ /for }}

{{ for cert of certifications.slice(0, 1) }}
<article class="e">
  <div>
    <div class="m">Latest certification</div>
    <div class="t">{{ cert.title }}</div>
    <div class="m">{{ cert.issuer }}</div>
  </div>
  <div class="d">{{ cert.date }}</div>
</article>
{{ /for }}

{{ for post of posts.slice(0, 1) }}
<article class="e">
  <div>
    <div class="m">Latest post</div>
    <div class="t"><a href="{{ post.url }}">{{ post.title }}</a></div>
  </div>
  <div class="d">{{ post.date |> date('HUMAN_DATE') }}</div>
</article>
{{ /for }}
