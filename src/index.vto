---
layout: layouts/base.vto
title: Marwan Ayman Shawky - Cloud & DevOps Engineer
description: Cloud & DevOps Engineer passionate about building scalable infrastructure and automating everything
---

{{ set posts = search.pages("type=post", "date=desc") |> sortPosts }}

<section class="hero">
  <div class="wrap">
    <div class="nameplate">
      <h1 class="name-lat">Marwan Ayman Shawky</h1>
      <p
        class="role">Cloud &amp; DevOps Engineer in Cairo, Egypt, focused on infrastructure automation, GitOps, and reliable systems.</p>
      <div class="hero-cta">
        <a class="b b1" href="/projects">View projects</a>
        <a class="b b2" href="/experience">See experience</a>
      </div>
    </div>
  </div>
</section>

<section class="sc">
  <div class="wrap">
    <div
      class="sec-head"><h2>Experience</h2><a href="/experience">View all →</a></div>
    <div>
      {{ for job of experience.slice(0, 1) }}
      <div class="e">
        <div>
          <div class="t">{{ job.title }}</div>
          <div class="m"><a href="{{ job.companyUrl }}" target="_blank" rel="noopener noreferrer">{{ job.company }}</a> · {{ job.location }}</div>
          <div class="m">{{ job.description }}</div>
          {{ comp.tech_tags({ tags: job.tags.slice(0, 5), wrapper: "tg" }) }}
        </div>
        <div class="d">{{ job.period }}</div>
      </div>
      {{ /for }}
    </div>
  </div>
</section>

<section class="sc">
  <div class="wrap">
    <div
      class="sec-head"><h2>Projects</h2><a href="/projects">View all →</a></div>
    <div>
      {{ for project of projects.slice(0, 1) }}
      <div class="e">
        <div>
          <div class="t">
            {{ if project.link }}
            <a href="{{ project.link }}" target="_blank" rel="noopener noreferrer">{{ project.title }}</a>
            {{ else }}
            {{ project.title }}
            {{ /if }}
          </div>
          <div class="m">{{ project.role }} · {{ project.period }}</div>
          <div class="m">{{ project.summary }}</div>
          {{ comp.tech_tags({ tags: project.tech.slice(0, 5), wrapper: "tg" }) }}
        </div>
      </div>
      {{ /for }}
    </div>
  </div>
</section>

<section class="sc">
  <div class="wrap">
    <div
      class="sec-head"><h2>Certifications</h2><a href="/certifications">View all →</a></div>
    <div>
      {{ for cert of certifications.slice(0, 1) }}
      <div class="e">
        <div>
          <div class="t">{{ cert.title }}</div>
          <div class="m">{{ cert.issuer }}</div>
        </div>
        <div class="d">{{ cert.date }}</div>
      </div>
      {{ /for }}
    </div>
  </div>
</section>

<section class="sc">
  <div class="wrap">
    <div class="sec-head"><h2>Blog</h2><a href="/blog">All articles →</a></div>
    <div>
      {{ for post of posts.slice(0, 1) }}
      <div class="e">
        <div>
          <div class="t"><a href="{{ post.url }}">{{ post.title }}</a></div>
        </div>
        <div class="d">{{ post.date |> date('HUMAN_DATE') }}</div>
      </div>
      {{ /for }}
    </div>
  </div>
</section>

<section class="sc">
  <div class="wrap">
    <div
      class="sec-head"><h2>Uses</h2><a href="/uses">Full inventory →</a></div>
    <div class="u">
      {{ for section of uses.slice(0, 1) }}
      <div>
        <div class="t">{{ section.group }}</div>
        <div class="m">{{ section.items.map((item) => item.name).join(", ") }}</div>
      </div>
      {{ /for }}
    </div>
  </div>
</section>
