---
layout: layouts/base.vto
title: Uses - Marwan Ayman Shawky
description: Tools, hardware, and software I use daily as a Cloud & DevOps Engineer
---

<div class="container">
  <section class="section">
    <p class="back-link">
      <a href="/"><span aria-hidden="true">←</span> Back</a>
    </p>

    <div class="shead">
      <h1 class="page-title">Uses</h1><span class="rule"></span><span class="ar" dir="rtl" lang="ar">عُدَّتي</span>
    </div>
    <p class="page-sub">
      Tools and gear I rely on daily. Inspired by <a href="https://uses.tech" target="_blank" rel="noopener noreferrer" style="border-bottom: 1px solid var(--brass); color: var(--brass);">uses.tech</a>.
    </p>

    {{ for section of uses }}
    <div class="uses-group" style="margin-bottom: 0;">
      <h2 class="uses-group-title">{{ section.group }}</h2>
      <ul class="uses-list">
        {{ for item of section.items }}
        <li class="uses-item">
          <div class="uses-item-name">{{ item.name }}</div>
          <div class="uses-item-desc">{{ item.desc }}</div>
        </li>
        {{ /for }}
      </ul>
    </div>
    {{ /for }}

  </section>
</div>
