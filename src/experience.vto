---
layout: layouts/base.vto
title: Experience - Marwan Ayman Shawky
description: DevOps training and internships focused on cloud automation
---

<div class="container">
  <section class="section">
    <p class="back-link">
      <a href="/"><span aria-hidden="true">←</span> Back</a>
    </p>

    <div class="shead">
      <h1 class="page-title">Experience</h1><span class="rule"></span><span class="ar" dir="rtl" lang="ar">الخبرة</span>
    </div>
    <p
      class="page-sub">Where the on-prem lessons came from — bare metal, self-hosted GitOps, and no managed control plane to hide behind.</p>

    <div class="experience-list" id="pagination-container">
      {{ for index, job of experience }}
      <div class="experience-item" data-pagination-item>
        <h2 class="job-title">{{ job.title }}</h2>
        
        <p class="job-company">
          <a href="{{ job.companyUrl }}" target="_blank" rel="noopener noreferrer">{{ job.company }}</a>
        </p>
        
        <p class="job-meta">
          {{ job.period }} · {{ job.location }}
        </p>
        
        <p class="job-description">{{ job.description }}</p>
        
        {{ if job.responsibilities }}
        <p class="responsibilities-title">Key Responsibilities:</p>
        <ul class="dash-list responsibilities-list">
          {{ for responsibility of job.responsibilities }}
          <li>{{ responsibility }}</li>
          {{ /for }}
        </ul>
        {{ /if }}
        
        <div class="tech-tags">
          {{ for tag of job.tags }}
          <span class="tech-tag">{{ tag }}</span>
          {{ /for }}
        </div>
      </div>
      {{ /for }}
    </div>
  </section>
</div>
