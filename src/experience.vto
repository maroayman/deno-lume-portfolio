---
layout: layouts/base.vto
title: Experience - Marwan Ayman Shawky
description: DevOps training and internships focused on cloud automation
---

<div class="container">
  <section class="section">
    {{ comp.page_header({ title: "Experience" }) }}
    <p
      class="page-sub">Where the on-prem lessons came from — bare metal, self-hosted GitOps, and no managed control plane to hide behind.</p>

    <div id="pagination-container">
      {{ for index, job of experience }}
      <div class="e" data-pagination-item>
        <div>
          <div class="t">{{ job.title }}</div>
          <div class="m"><a href="{{ job.companyUrl }}" target="_blank" rel="noopener noreferrer">{{ job.company }}</a> · {{ job.location }}</div>
          <div class="m">{{ job.description }}</div>
          {{ if job.responsibilities }}
          <details class="responsibilities" name="job-responsibilities">
            <summary class="responsibilities-title">Key responsibilities ({{ job.responsibilities.length }})</summary>
            <ul class="dash-list responsibilities-list">
              {{ for responsibility of job.responsibilities }}
              <li>{{ responsibility }}</li>
              {{ /for }}
            </ul>
          </details>
          {{ /if }}
          {{ comp.tech_tags({ tags: job.tags, wrapper: "tg" }) }}
        </div>
        <div class="d">{{ job.period }}</div>
      </div>
      {{ /for }}
    </div>
  </section>
</div>
