---
layout: layouts/base.vto
title: 404 - Page Not Found
description: The page you're looking for doesn't exist
---

<div class="container">
  <section class="section" aria-labelledby="notfound-title">
    <div class="shead">
      <h1 class="page-title" id="notfound-title">Not found</h1><span class="rule"></span><span class="ar" dir="rtl" lang="ar">غير موجود</span>
    </div>
    <p
      class="page-sub">That address is not on the map. The terminal below is the whole story.</p>
    <div class="terminal-404" role="presentation">
      <div class="terminal-header" aria-hidden="true">
        <span class="terminal-dot red" aria-hidden="true"></span>
        <span class="terminal-dot yellow" aria-hidden="true"></span>
        <span class="terminal-dot green" aria-hidden="true"></span>
        <span class="terminal-title">bash</span>
      </div>
      <div class="terminal-body">
        <p><span class="terminal-prompt">$</span> curl https://maroayman.vercel.app<span class="terminal-path">/404</span></p>
        <p class="terminal-output"></p>
        <p class="terminal-error">HTTP/1.1 404 Not Found</p>
        <p class="terminal-output"></p>
        <p class="terminal-json">{</p>
        <p class="terminal-json">  "error": "Page not found",</p>
        <p class="terminal-json">  "status": 404,</p>
        <p class="terminal-json">  "suggestion": "Try the homepage"</p>
        <p class="terminal-json">}</p>
        <p class="terminal-output"></p>
        <p><span class="terminal-prompt">$</span> <span class="terminal-cursor">_</span></p>
      </div>
    </div>

    <div style="margin-top: 2rem;">
      <a href="/"
        class="resume-button"><span aria-hidden="true">←</span> cd /home</a>
    </div>
  </section>
</div>
