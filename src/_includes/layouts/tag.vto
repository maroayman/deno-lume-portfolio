---
layout: layouts/base.vto
---
    {{ comp.back_link({ href: "/blog", label: "Back to Blog" }) }}

    <h1>{{ tag }}</h1>

    <p class="in"
  role="status" aria-live="polite" aria-atomic="true">
      <span id="tagResultCount">{{ posts.length }}</span> article{{ posts.length === 1 ? "" : "s" }} tagged here
    </p>

    <!-- Search (shared component; wired up by assets/tag-filter.js). -->
    <div class="blog-search-container" style="margin-bottom: 1.5rem;">
      {{ comp.blog_search({ id: "tagSearch", clearId: "tagSearchClear", type: "search", placeholder: "Filter articles…", label: "Filter articles" }) }}
    </div>

    <div class="blog-grid" id="tagGrid">
      {{ for post of posts }}
      {{ include "partials/blog-card.vto" { post, showBookmark: false, paginationItem: true } }}
      {{ /for }}
    </div>

    <p id="tagNoResults"
  style="display:none; color: var(--ink-2); margin-top: 1.5rem;"
  role="status" aria-live="polite">
      No articles match your search.
    </p>

    <nav aria-label="Tag pagination">
  <div class="pagination" id="tagPagination"></div>
</nav>

<!-- Without JS there is no pagination to page through: undo the
     pre-hide (see .blog-grid rule) and show every card. -->
<noscript><style>.blog-grid > :nth-child(n+7){display:block !important}</style></noscript>

<!-- Tag filter + pagination (external for CSP script-src 'self'). -->
<script src="/assets/tag-filter.js" defer></script>
