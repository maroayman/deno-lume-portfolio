---
layout: layouts/base.vto
---
<div class="container">
  <section class="section">
    <p class="back-link">
      <a href="/blog"><span aria-hidden="true">←</span> Back to Blog</a>
    </p>

    <div class="shead">
      <h1 class="page-title tag-page-title">
        Posts tagged <span class="tech-tag" style="font-size: inherit; vertical-align: middle;">{{ tag }}</span>
      </h1><span class="rule"></span><span class="ar" dir="rtl" lang="ar">وسم</span>
    </div>

    <p class="page-sub"
      role="status" aria-live="polite" aria-atomic="true">
      <span id="tagResultCount">{{ posts.length }}</span> article{{ posts.length === 1 ? "" : "s" }}
    </p>

    <!-- Search -->
    <div class="blog-search-container" style="margin-bottom: 1.5rem;">
      <div class="blog-search-wrapper">
        <svg class="blog-search-icon" aria-hidden="true" focusable="false"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="search"
          id="tagSearch"
          class="blog-search-input"
          placeholder="Filter articles…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Filter articles"
        >
      </div>
    </div>

    <div class="blog-grid" id="tagGrid">
      {{ for post of posts }}
      {{ include "partials/blog-card.vto" { post, showBookmark: false, paginationItem: true } }}
      {{ /for }}
    </div>

    <p id="tagNoResults"
      style="display:none; color: var(--ink-2); margin-top: 1.5rem;"
      role="status" aria-live="polite">
      No articles match your search.
    </p>

    <nav aria-label="Tag pagination">
      <div class="pagination" id="tagPagination"></div>
    </nav>
  </section>
</div>

<!-- Tag filter + pagination (external for CSP script-src 'self'). -->
<script src="/assets/tag-filter.js" defer></script>
