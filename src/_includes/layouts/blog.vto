---
layout: layouts/base.vto
---
<div class="container">
  <section class="section">
    <p class="back-link">
      <a href="/blog"><span aria-hidden="true">←</span> Back to Blog</a>
    </p>

    <article class="blog-article">
      {{ if cover }}
      <figure class="blog-cover" data-lightbox>
        <img src="{{ cover }}" alt="{{ title }} cover image" width="1200" height="675" loading="eager" fetchpriority="high" decoding="async">
      </figure>
      {{ /if }}

      <header class="blog-header">
        <h1 class="blog-title">{{ title }}</h1>
        <div class="blog-meta">
          <time datetime="{{ date |> date('DATE') }}">{{ date |> date('HUMAN_DATE') }}</time>
          <span>·</span>
          <span id="readingTime">{{ readingTime ?? 1 }} min read</span>
          <span>·</span>
          <span id="wordCount"></span>
        </div>
        {{ if tags }}
        <div class="blog-tags">
          {{ for tag of tags }}
          <span class="tech-tag">{{ tag }}</span>
          {{ /for }}
        </div>
        {{ /if }}

        <!-- Social Share Buttons -->
        <div class="social-share">
          <span class="share-label">Share:</span>
          {{ comp.share_btn({ id: "shareTwitter", label: "Share on Twitter", title: "Share on Twitter", icon: "x-logo", size: 18 }) }}
          {{ comp.share_btn({ id: "shareLinkedIn", label: "Share on LinkedIn", title: "Share on LinkedIn", icon: "linkedin", size: 18 }) }}
          {{ comp.share_btn({ id: "shareNative", label: "Share", title: "Share", icon: "share", size: 18 }) }}
          <span class="visually-hidden" aria-live="polite" id="shareStatus"></span>
        </div>
      </header>

      <!-- Table of Contents (injected by JS if enough headings) -->
      <nav class="toc" id="toc" aria-label="Table of contents" style="display:none;">
        <button class="toc-toggle" id="tocToggle" aria-expanded="false" aria-controls="tocList">
          <span>Table of Contents</span>
          {{ comp.icon({ name: "chevron-down", size: 14, cls: "toc-toggle-icon", a11y: false }) }}
        </button>
        <ul class="toc-list" id="tocList"></ul>
      </nav>

      <div class="blog-content">
        {{ content }}
      </div>

      <!-- Social Share (Bottom) -->
      <div class="social-share social-share-bottom">
        <span class="share-label">Enjoyed this article? Share it:</span>
        <div class="share-buttons">
          {{ comp.share_btn({ id: "shareTwitterBottom", label: "Share on Twitter", icon: "x-logo", size: 20, text: "Twitter", large: true }) }}
          {{ comp.share_btn({ id: "shareLinkedInBottom", label: "Share on LinkedIn", icon: "linkedin", size: 20, text: "LinkedIn", large: true }) }}
          {{ comp.share_btn({ id: "shareNativeBottom", label: "Share", icon: "share", size: 20, text: "More", large: true }) }}
        </div>
      </div>
    </article>

    <!-- Related Posts -->
    {{ if tags }}
    {{ set relatedPosts = search.pages("type=post", "date=desc").slice().sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime() || String(a.title).localeCompare(String(b.title))).filter(p => p.url !== url && p.tags && p.tags.some(t => tags.includes(t))).slice(0, 3) }}
    {{ if relatedPosts.length > 0 }}
    <section class="related-posts" aria-labelledby="related-title">
      <h2 class="related-posts-title" id="related-title">Related Articles</h2>
      <div class="related-posts-grid">
        {{ for post of relatedPosts }}
        <a href="{{ post.url }}" class="related-post-card">
          {{ if post.cover }}
          <div class="related-post-cover">
            <img src="{{ post.cover.replace(/(\.[a-z]+)$/, "-thumb$1") }}" srcset="{{ post.cover.replace(/(\.[a-z]+)$/, "-thumb$1") }} 320w, {{ post.cover }} 1024w" sizes="(max-width: 700px) 100vw, 400px" alt="" width="1200" height="675" loading="lazy" decoding="async">
          </div>
          {{ /if }}
          <div class="related-post-content">
            <h3>{{ post.title }}</h3>
            <div class="related-post-meta">
              <time datetime="{{ post.date |> date('DATE') }}">{{ post.date |> date('HUMAN_DATE') }}</time>
            </div>
          </div>
        </a>
        {{ /for }}
      </div>
    </section>
    {{ /if }}
    {{ /if }}
  </section>
</div>

<script src="/assets/blog-post.js" defer></script>
