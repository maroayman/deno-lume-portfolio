<!DOCTYPE html>
<html lang="en">
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title ?? site.author }}</title>
  <meta name="description" content="{{ description ?? site.description }}">
  {{ if url === "/404.html" }}<meta name="robots" content="noindex">{{ /if }}
  {{ if url !== "/404.html" }}<link rel="canonical" href="{{ site.url }}{{ url }}">{{ /if }}
  <link rel="alternate" type="application/rss+xml" title="{{ site.author }} — Blog" href="/feed.rss">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#EDE3CF">
  <meta name="color-scheme" content="light dark">

  <!-- SEO Meta Tags -->
  <meta property="og:title" content="{{ title ?? site.author }}">
  <meta property="og:description" content="{{ description ?? site.description }}">
  <meta property="og:site_name" content="{{ site.author }}">
  <meta property="og:locale" content="en_US">
  {{ if type === "post" }}
  {{ set ogImage = cover ? (cover.startsWith("http") ? cover : site.url + cover) : null }}
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{ site.url }}{{ url }}">
  <meta property="article:published_time" content="{{ date |> date('DATE') }}">
  {{ if ogImage }}
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {{ /if }}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title ?? site.author }}">
  <meta name="twitter:description" content="{{ description ?? site.description }}">
  {{ if ogImage }}
  <meta name="twitter:image" content="{{ ogImage }}">
  {{ /if }}
  {{ else }}
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ url }}">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title ?? site.author }}">
  <meta name="twitter:description" content="{{ description ?? site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  {{ /if }}
  <meta name="author" content="{{ site.author }}">

  <!-- JSON-LD Structured Data -->
  {{ if type === "post" }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ JSON.stringify(title ?? site.author) }},
    "description": {{ JSON.stringify(description ?? site.description) }},
    "url": "{{ site.url }}{{ url }}",
    "datePublished": "{{ date |> date('DATE') }}",
    "dateModified": "{{ (updated ?? date) |> date('DATE') }}",
    {{ if cover }}
    "image": {{ JSON.stringify(cover) }},
    {{ /if }}
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}"
    },
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.url }}/og-image.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ site.url }}{{ url }}"
    }
    {{ if tags }},
    "keywords": {{ JSON.stringify(tags.join(", ")) }}
    {{ /if }}
  }
  </script>
  {{ else }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.author }}",
    "url": "{{ site.url }}",
    "description": {{ JSON.stringify(description ?? site.description) }},
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}",
      "jobTitle": "{{ site.tagline }}"
    }
  }
  </script>
  {{ /if }}

  <!-- Styles (inlined for performance) -->
  <link rel="stylesheet" href="/styles/main.css" inline>
  <link rel="stylesheet" href="/styles/blog.css" inline>
  <link rel="stylesheet" href="/styles/pages.css" inline>

  {{ include "partials/head-theme-flash.vto" }}
  {{ include "partials/head-prefetch.vto" }}
  </head>
  <body>
  <!-- Mashrabiya lattice defs — shared by hero screen + lightwash -->
  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
      <pattern id="mash" width="56" height="56" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="var(--brass)" stroke-width="1.15" opacity="1">
          <rect x="14" y="14" width="28" height="28"/>
          <rect x="14" y="14" width="28" height="28" transform="rotate(45 28 28)"/>
          <path d="M0 28 H8.2 M47.8 28 H56 M28 0 V8.2 M28 47.8 V56"/>
          <path d="M0 0 L14 14 M56 0 L42 14 M0 56 L14 42 M56 56 L42 42"/>
        </g>
      </pattern>
    </defs>
  </svg>

  {{ if type === "post" }}
  <!-- Reading Progress Bar -->
  <div class="reading-progress" id="readingProgress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
  {{ /if }}

  <!-- Back to Top Button -->
  <button class="floating-btn back-to-top" id="backToTop" aria-label="Back to top" aria-hidden="true" tabindex="-1" hidden>
    <svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
    </svg>
  </button>

  {{ if type === "post" }}
  <!-- Image Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true" hidden inert>
    <button class="lightbox-close" id="lightboxClose" aria-label="Close lightbox">&times;</button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Previous image">
      <svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
    <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Next image">
      <svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
    <div class="lightbox-content">
      <img class="lightbox-image" id="lightboxImage" alt="">
      <p class="lightbox-caption" id="lightboxCaption" aria-live="polite"></p>
    </div>
  </div>
  {{ /if }}

  <!-- Masthead -->
  <header class="masthead">
    <div class="wrap">
      <a class="mark" href="/">MARWAN<b>.</b>AYMAN</a>
      <nav class="masthead-nav" aria-label="Primary">
        {{ for item of site.navigation }}
        {{ if item.href === "/" }}
        <a href="/" {{ if url === "/" }}aria-current="page"{{ /if }}>Home</a>
        {{ else }}
        <a href="{{ item.href }}" {{ if url.startsWith(item.href) }}aria-current="page"{{ /if }}>{{ item.label }}</a>
        {{ /if }}
        {{ /for }}
      </nav>
      <button class="lamp" id="themeToggle" type="button" aria-label="Night, switch to dark mode" aria-pressed="false">
        <svg class="sun-icon" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg class="moon-icon" aria-hidden="true" focusable="false" style="display: none;" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
        <span class="lamp-label" id="themeLabel">Night</span>
      </button>
    </div>
  </header>

  <!-- Main Content -->
  <main id="main-content" tabindex="-1">
    {{ content }}
  </main>

  <!-- Footer -->
  <footer>
    <div class="wrap">
      <div class="foot">
        <div>
          <h2 class="foot-heading">Elsewhere</h2>
          <ul class="social-links">
            <li>
              <a href="https://github.com/maroayman" aria-label="GitHub">
                <svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" width="22" height="22">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://linkedin.com/in/maroayman" aria-label="LinkedIn">
                <svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" width="22" height="22">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
                </svg>
              </a>
            </li>
            <li>
              <a href="https://gitlab.com/maroayman" aria-label="GitLab">
                <svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" width="22" height="22">
                  <path d="m23.6004 9.5927-.0337-.0862L20.3.9814a.851.851 0 0 0-.3362-.405.8748.8748 0 0 0-.9997.0539.8748.8748 0 0 0-.29.4399l-2.2055 6.748H7.5375l-2.2057-6.748a.8573.8573 0 0 0-.29-.4412.8748.8748 0 0 0-.9997-.0537.8585.8585 0 0 0-.3362.4049L.4332 9.5015l-.0325.0862a6.0657 6.0657 0 0 0 2.0119 7.0105l.0113.0087.03.0213 4.976 3.7264 2.462 1.8633 1.4995 1.1321a1.0085 1.0085 0 0 0 1.2197 0l1.4995-1.1321 2.4619-1.8633 5.006-3.7489.0125-.01a6.0682 6.0682 0 0 0 2.0094-7.003z"/>
                </svg>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="foot-heading">Get in touch</h2>
          <ul class="social-links">
            <li>
              <a href="mailto:marwanayman.shawky@gmail.com" aria-label="Email">
                <svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" width="22" height="22">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </a>
            </li>
            <li>
              <a href="tel:+201122889126" aria-label="Phone: +20 112 288 9126">
                <svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" width="22" height="22">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="foot-heading">Résumé</h2>
          <ul class="social-links">
            <li>
              <a href="/resume.pdf" aria-label="Download résumé PDF">
                <svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" width="22" height="22">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" x2="12" y1="15" y2="3"></line>
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="colophon">
        <span>© <span id="year"></span> {{ site.author }} — Set in Reem Kufi, Archivo and IBM Plex Sans Arabic. Built with Deno &amp; Lume.</span>
        <span class="ar" dir="rtl" lang="ar">صُنع في القاهرة</span>
      </div>
    </div>
  </footer>

  {{ include "partials/scripts-common.vto" }}
  {{ include "partials/scripts-sw.vto" }}
  </body>
</html>
