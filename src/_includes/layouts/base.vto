<!DOCTYPE html>
<html lang="en">
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title ?? site.author }}</title>
  <meta name="description" content="{{ description ?? site.description }}">
  {{ if url === "/404.html" }}<meta name="robots" content="noindex">{{ /if }}
  {{ if url !== "/404.html" }}<link rel="canonical" href="{{ site.url }}{{ url }}">{{ /if }}
  <link rel="alternate" type="application/rss+xml" title="{{ site.author }} — Blog" href="/feed.rss">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#C9C4EC">
  <meta name="color-scheme" content="light">
  <!-- Avatar is the LCP image only on the links page: preload it there so
       it doesn't wait for body discovery. Scoped to /links/ on purpose —
       every other page would log "preloaded but not used". Post bylines
       are loading="lazy", so they need no preload. imagesrcset (not href)
       is required: the avatar is served via <picture>/<source srcset>,
       and Chrome only matches srcset-driven fetches against imagesrcset. -->
  {{ if url === "/links/" }}<link rel="preload" as="image" imagesrcset="/profile/profile.avif" type="image/avif" fetchpriority="high">{{ /if }}
  <!-- Type is the LCP element (window title + h1): preload the single
       vendored Onest variable face so first paint already uses it.
       Same-origin, so CSP font-src 'self' covers it. -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/onest-latin.woff2" fetchpriority="high">
  <!-- Cross-document view transitions (Chrome/Edge 126+, Safari 18+):
       same-origin MPA navigations crossfade instead of flashing white,
       which is the main source of perceived delay on fast static pages. -->
  <meta name="view-transition" content="same-origin">

  <!-- SEO Meta Tags -->
  <meta property="og:title" content="{{ title ?? site.author }}">
  <meta property="og:description" content="{{ description ?? site.description }}">
  <meta property="og:site_name" content="{{ site.author }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content="{{ site.url }}{{ url }}">
  <meta name="twitter:title" content="{{ title ?? site.author }}">
  <meta name="twitter:description" content="{{ description ?? site.description }}">
  {{ if type === "post" }}
  {{ set ogImage = cover ? (cover.startsWith("http") ? cover : site.url + cover) : null }}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ date |> date('DATE') }}">
  {{ if ogImage }}
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {{ /if }}
  <meta name="twitter:card" content="summary_large_image">
  {{ if ogImage }}
  <meta name="twitter:image" content="{{ ogImage }}">
  {{ /if }}
  {{ else }}
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  {{ /if }}
  <meta name="author" content="{{ site.author }}">

  <!-- JSON-LD Structured Data -->
  {{ if type === "post" }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ JSON.stringify(title ?? site.author) }},
    "description": {{ JSON.stringify(description ?? site.description) }},
    "url": "{{ site.url }}{{ url }}",
    "datePublished": "{{ date |> date('DATE') }}",
    "dateModified": "{{ (updated ?? date) |> date('DATE') }}",
    {{ if ogImage }}
    "image": {{ JSON.stringify(ogImage) }},
    {{ /if }}
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}"
    },
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.url }}/og-image.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ site.url }}{{ url }}"
    }
    {{ if tags }},
    "keywords": {{ JSON.stringify(tags.join(", ")) }}
    {{ /if }}
  }
  </script>
  {{ else }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.author }}",
    "url": "{{ site.url }}",
    "description": {{ JSON.stringify(description ?? site.description) }},
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}",
      "jobTitle": "{{ site.tagline }}"
    }
  }
  </script>
  {{ /if }}

  <!-- Styles (inlined for performance; blog/pages CSS only where used
       to keep non-blog HTML small for FCP/LCP) -->
  <link rel="stylesheet" href="/styles/main.css" inline>
  {{ if type === "post" || url.startsWith("/blog") || url === "/uses/" || url === "/links/" || url === "/404.html" }}
  <link rel="stylesheet" href="/styles/blog.css" inline>
  <link rel="stylesheet" href="/styles/pages.css" inline>
  {{ /if }}

  {{ include "partials/head-theme-flash.vto" }}
  {{ include "partials/head-prefetch.vto" }}
  </head>
  <body>
  {{ if type === "post" }}
  <!-- Reading Progress Bar -->
  <div class="reading-progress" id="readingProgress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
  {{ /if }}

  <!-- Back to Top Button -->
  <button class="floating-btn back-to-top" id="backToTop" aria-label="Back to top" aria-hidden="true" tabindex="-1" hidden>
    {{ comp.icon({ name: "arrow-up" }) }}
  </button>

  {{ if type === "post" }}
  <!-- Image Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true" hidden inert>
    <button class="lightbox-close" id="lightboxClose" aria-label="Close lightbox">&times;</button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Previous image">
      {{ comp.icon({ name: "chevron-left" }) }}
    </button>
    <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Next image">
      {{ comp.icon({ name: "chevron-right" }) }}
    </button>
    <div class="lightbox-content">
      <img class="lightbox-image" id="lightboxImage" alt="">
      <p class="lightbox-caption" id="lightboxCaption" aria-live="polite"></p>
    </div>
  </div>
  {{ /if }}

  <!-- Dock shell: menu bar + centered window + bottom dock.
       The title bar names the page; content keeps its own h1s.
       Nav renders server-side (no client JS); active link uses
       aria-current + .on, repainted by spa-nav.js after each swap.
       winTitle is synced the same way. -->
  {{ if word }}
  {{ set wt = word }}
  {{ else if tag }}
  {{ set wt = tag }}
  {{ else if url === "/" }}
  {{ set wt = "Home" }}
  {{ else if url.startsWith("/experience") }}
  {{ set wt = "Experience" }}
  {{ else if url.startsWith("/projects") }}
  {{ set wt = "Projects" }}
  {{ else if url.startsWith("/certifications") }}
  {{ set wt = "Certifications" }}
  {{ else if url.startsWith("/blog") }}
  {{ set wt = "Blog" }}
  {{ else if url.startsWith("/uses") }}
  {{ set wt = "Uses" }}
  {{ else if url.startsWith("/links") }}
  {{ set wt = "Links" }}
  {{ else }}
  {{ set wt = "Not found" }}
  {{ /if }}
  <div class="s">
    <div class="mb"><span class="mb-name">{{ site.author }}</span><div class="mb-right">{{ if site.availability === "selective" }}{{ set avLabel = "Selectively Available" }}{{ set avColor = "#EAB308" }}{{ set avGlow = "rgba(234, 179, 8, .55)" }}{{ else if site.availability === "unavailable" }}{{ set avLabel = "Unavailable" }}{{ set avColor = "#EF4444" }}{{ set avGlow = "rgba(239, 68, 68, .55)" }}{{ else }}{{ set avLabel = "Open to Work" }}{{ set avColor = "#22C55E" }}{{ set avGlow = "rgba(34, 197, 94, .55)" }}{{ /if }}<div class="av"><i aria-hidden="true" style="--av: {{ avColor }}; --av-glow: {{ avGlow }}"></i>{{ avLabel }}</div><button id="themeToggle" class="theme-btn" aria-label="Switch to dark mode" aria-pressed="false">{{ comp.icon({ name: "moon", size: 18 }) }}{{ comp.icon({ name: "sun", size: 18 }) }}</button></div></div>
    <div class="wd">
      <div class="win">
        <div class="tb"><span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span><span id="winTitle">{{ wt }}</span></div>
        <div class="bdy">
          <!-- Main Content -->
          <main id="main-content" tabindex="-1">
            {{ content }}
          </main>

          <!-- Footer (slim colophon inside the window) -->
          <footer>
            <div class="colophon">
              <span>© <span id="year"></span> {{ site.author }} — Built with Deno &amp; Lume.</span>
            </div>
          </footer>
        </div>
      </div>
      <nav class="dk" aria-label="Primary">
        {{ for item of site.navigation }}
        {{ if item.href === "/" }}
        <a href="/" {{ if url === "/" }}class="on" aria-current="page"{{ /if }}>{{ comp.icon({ name: item.icon }) }}Home</a>
        {{ else }}
        <a href="{{ item.href }}" {{ if url.startsWith(item.href) }}class="on" aria-current="page"{{ /if }}>{{ comp.icon({ name: item.icon }) }}{{ item.label }}</a>
        {{ /if }}
        {{ /for }}
      </nav>
    </div>
  </div>

  {{ include "partials/scripts-common.vto" }}
  {{ include "partials/scripts-sw.vto" }}
  </body>
</html>
