<!DOCTYPE html>
<html lang="en">
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title ?? site.author }}</title>
  <meta name="description" content="{{ description ?? site.description }}">
  {{ if url === "/404.html" }}<meta name="robots" content="noindex">{{ /if }}
  {{ if url !== "/404.html" }}<link rel="canonical" href="{{ site.url }}{{ url }}">{{ /if }}
  <link rel="alternate" type="application/rss+xml" title="{{ site.author }} — Blog" href="/feed.rss">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#1A1F27">
  <meta name="color-scheme" content="dark">

  <!-- SEO Meta Tags -->
  <meta property="og:title" content="{{ title ?? site.author }}">
  <meta property="og:description" content="{{ description ?? site.description }}">
  <meta property="og:site_name" content="{{ site.author }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content="{{ site.url }}{{ url }}">
  <meta name="twitter:title" content="{{ title ?? site.author }}">
  <meta name="twitter:description" content="{{ description ?? site.description }}">
  {{ if type === "post" }}
  {{ set ogImage = cover ? (cover.startsWith("http") ? cover : site.url + cover) : null }}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ date |> date('DATE') }}">
  {{ if ogImage }}
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {{ /if }}
  <meta name="twitter:card" content="summary_large_image">
  {{ if ogImage }}
  <meta name="twitter:image" content="{{ ogImage }}">
  {{ /if }}
  {{ else }}
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  {{ /if }}
  <meta name="author" content="{{ site.author }}">

  <!-- JSON-LD Structured Data -->
  {{ if type === "post" }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ JSON.stringify(title ?? site.author) }},
    "description": {{ JSON.stringify(description ?? site.description) }},
    "url": "{{ site.url }}{{ url }}",
    "datePublished": "{{ date |> date('DATE') }}",
    "dateModified": "{{ (updated ?? date) |> date('DATE') }}",
    {{ if ogImage }}
    "image": {{ JSON.stringify(ogImage) }},
    {{ /if }}
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}"
    },
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.url }}/og-image.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ site.url }}{{ url }}"
    }
    {{ if tags }},
    "keywords": {{ JSON.stringify(tags.join(", ")) }}
    {{ /if }}
  }
  </script>
  {{ else }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.author }}",
    "url": "{{ site.url }}",
    "description": {{ JSON.stringify(description ?? site.description) }},
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}",
      "jobTitle": "{{ site.tagline }}"
    }
  }
  </script>
  {{ /if }}

  <!-- Styles (inlined for performance; blog/pages CSS only where used
       to keep non-blog HTML small for FCP/LCP) -->
  <link rel="stylesheet" href="/styles/main.css" inline>
  {{ if type === "post" || url.startsWith("/blog") || url === "/uses/" || url === "/404.html" }}
  <link rel="stylesheet" href="/styles/blog.css" inline>
  <link rel="stylesheet" href="/styles/pages.css" inline>
  {{ /if }}

  {{ include "partials/head-theme-flash.vto" }}
  {{ include "partials/head-prefetch.vto" }}
  </head>
  <body>
  {{ if type === "post" }}
  <!-- Reading Progress Bar -->
  <div class="reading-progress" id="readingProgress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
  {{ /if }}

  <!-- Back to Top Button -->
  <button class="floating-btn back-to-top" id="backToTop" aria-label="Back to top" aria-hidden="true" tabindex="-1" hidden>
    {{ comp.icon({ name: "arrow-up" }) }}
  </button>

  {{ if type === "post" }}
  <!-- Image Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true" hidden inert>
    <button class="lightbox-close" id="lightboxClose" aria-label="Close lightbox">&times;</button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Previous image">
      {{ comp.icon({ name: "chevron-left" }) }}
    </button>
    <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Next image">
      {{ comp.icon({ name: "chevron-right" }) }}
    </button>
    <div class="lightbox-content">
      <img class="lightbox-image" id="lightboxImage" alt="">
      <p class="lightbox-caption" id="lightboxCaption" aria-live="polite"></p>
    </div>
  </div>
  {{ /if }}

  <!-- Slate shell: sticky sidebar + single-column main.
       Nav + social render server-side from site data (no client JS,
       no React runtime). Active link uses aria-current + .on. -->
  <div class="s">
    <aside class="r">
      <img class="avatar" src="/profile/profile.jpg" alt="Marwan Ayman Shawky" width="192" height="196" fetchpriority="high" decoding="async">
      <div class="av"><i aria-hidden="true"></i>Open to work</div>
      <nav class="slate-nav" aria-label="Primary">
        {{ for item of site.navigation }}
        {{ if item.href === "/" }}
        <a href="/" {{ if url === "/" }}class="on" aria-current="page"{{ /if }}>Home</a>
        {{ else }}
        <a href="{{ item.href }}" {{ if url.startsWith(item.href) }}class="on" aria-current="page"{{ /if }}>{{ item.label }}</a>
        {{ /if }}
        {{ /for }}
      </nav>
      <div class="so">
        <a href="https://github.com/maroayman" aria-label="GitHub">{{ comp.icon({ name: "rail-github" }) }}</a>
        <a href="https://linkedin.com/in/maroayman" aria-label="LinkedIn">{{ comp.icon({ name: "rail-linkedin" }) }}</a>
        <a href="https://gitlab.com/maroayman" aria-label="GitLab">{{ comp.icon({ name: "rail-gitlab" }) }}</a>
        <a href="https://linktr.ee/maroayman" aria-label="Linktree">{{ comp.icon({ name: "rail-linktree" }) }}</a>
        <a href="mailto:marwanayman.shawky@gmail.com" aria-label="Email">{{ comp.icon({ name: "rail-mail" }) }}</a>
      </div>
    </aside>

    <div class="s-main">
      <!-- Main Content -->
      <main id="main-content" tabindex="-1">
        {{ content }}
      </main>

      <!-- Footer (slim colophon; Elsewhere/Get in touch live in the rail) -->
      <footer>
        <div class="wrap">
          <div class="colophon">
            <span>© <span id="year"></span> {{ site.author }} — Built with Deno &amp; Lume.</span>
          </div>
        </div>
      </footer>
    </div>
  </div>

  {{ include "partials/scripts-common.vto" }}
  {{ include "partials/scripts-sw.vto" }}
  </body>
</html>
