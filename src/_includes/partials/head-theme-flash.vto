<!-- Apply theme immediately to prevent flash of unstyled content.
     Priority: 1) explicit localStorage value, 2) OS prefers-color-scheme.
     Inlined (no request, no render-blocking) — CSP allows it via the
     sha256 hash in vercel.json. The hash covers the INLINED bytes
     (source minus trailing newline); re-verify from built output after
     changing this file, dev and prod must agree. -->
<script src="/assets/theme-flash.js" inline></script>
