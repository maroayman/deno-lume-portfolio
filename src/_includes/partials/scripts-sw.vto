<div id="sw-toast" role="status" aria-live="polite" aria-atomic="true"
  style="display:none; position:fixed; bottom:1rem; left:50%; transform:translateX(-50%); background:var(--paper-2); border:1px solid var(--line); padding:0.75rem 1rem; border-radius:var(--radius); box-shadow:0 4px 16px rgba(0,0,0,0.12); z-index:999; gap:0.5rem; align-items:center;">
  <span>New version available</span>
  <button id="sw-toast-reload" class="resume-button"
    style="margin-left:0.5rem; padding:0.25rem 0.6rem;">Reload</button>
  <button id="sw-toast-dismiss" aria-label="Dismiss"
    style="background:none; border:none; cursor:pointer; padding:0.25rem; margin-left:0.25rem;">✕</button>
</div>
<!-- Service worker registration (external for CSP script-src 'self'). -->
<script src="/assets/sw-register.js" defer></script>
