<!-- Speculation Rules for faster navigation (Chrome/Edge 109+).
     Inline: browsers ignore src on type="speculationrules", so external
     files warn and are never applied. Unlike ld+json, inline
     speculation rules ARE gated by CSP script-src — allowed via
     'inline-speculation-rules' in vercel.json (no unsafe-inline needed).
     NOTE: headline/body fonts (Albert Sans + IBM Plex Mono) are
     CSS-discovered via @font-face — no separate preloads. -->
<script type="speculationrules">
{
  "prerender": [
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/blog/*" },
          { "href_matches": "/projects" },
          { "href_matches": "/experience" },
          { "href_matches": "/certifications" },
          { "not": { "href_matches": "/*\\?*" } },
          { "not": { "selector_matches": "[rel~=external]" } },
          { "not": { "selector_matches": "[target=_blank]" } }
        ]
      },
      "eagerness": "conservative"
    }
  ]
}
</script>
