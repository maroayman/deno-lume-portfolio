<article class="blog-card" {{ if paginationItem }} data-pagination-item{{ /if }}
  data-url="{{ post.url }}" {{ if paginationItem }}
  data-title="{{ post.title }}"
  data-tags="{{ post.tags ? post.tags.join(',').toLowerCase() : '' }}"
  data-description="{{ post.description }}" {{ /if }}>
  {{ if post.cover }}
  <div class="blog-card-cover">
    <img src="{{ post.cover.replace(/(\.[a-z]+)$/, "-thumb$1") }}" srcset="{{ post.cover.replace(/(\.[a-z]+)$/, "-thumb$1") }} 320w, {{ post.cover }} 1024w" sizes="80px" alt="" width="80" height="60" loading="lazy" decoding="async">
  </div>
  {{ /if }}
  <div class="blog-card-content">
    <div class="blog-card-header">
      <h2 class="blog-card-title">
        <a href="{{ post.url }}">{{ post.title }}</a>
      </h2>
      {{ if showBookmark }}
      <button class="bookmark-btn" data-url="{{ post.url }}" aria-label="Bookmark article" aria-pressed="false" title="Bookmark">
        {{ comp.icon({ name: "bookmark", cls: "bookmark-icon" }) }}
      </button>
      {{ /if }}
    </div>
    <div class="blog-card-meta">
      <time datetime="{{ post.date |> date('DATE') }}">{{ post.date |> date('HUMAN_DATE') }}</time>
      {{ if post.readingTime }}
      <span>· {{ post.readingTime }} min read</span>
      {{ /if }}
      <span class="read-inline">· ✓ Read</span>
    </div>
    <p class="blog-card-excerpt">{{ post.description }}</p>
    {{ comp.tech_tags({ tags: post.tags, linked: true, paginationItem: paginationItem }) }}
  </div>
</article>
