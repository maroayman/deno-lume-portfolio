{{# Section header: plain Slate heading.
The `ar` prop is kept optional for later reuse but renders nothing
unless provided.

Props:
- `title`: heading text.
- `ar`: optional Arabic label text (omitted renders nothing).
- `level`: heading level, "h1" (default) or "h2".
- `cls`: heading class, defaults to "page-title". Pass "" for plain
  heading (homepage h2 sections).
- `id`: optional heading id (404 page).
#}}
{{ set level = level ?? "h1" }}
{{ set cls = cls ?? "page-title" }}
<div class="shead">
  <{{ level }}{{ if cls }} class="{{ cls }}"{{ /if }}{{ if id }} id="{{ id }}"{{ /if }}>{{ title }}</{{ level }}>{{ if ar }}<span class="rule"></span><span class="ar" dir="rtl" lang="ar">{{ ar }}</span>{{ /if }}
</div>
