{{# Blog tag filters: top-5 quick tags + searchable dropdown for the rest
+ active-filter indicator (wired up by assets/blog-list.js).

Props:
- `counts`: [{ tag, count }] sorted by count desc (posts |> tagCounts).
- `total`: total post count for the "All" button.
#}}
<div class="blog-tags-filter" id="tagFiltersContainer" role="group"
  aria-label="Filter posts by tag">
  <!-- Quick filter: Top tags + dropdown for more -->
  <div class="quick-tags">
    <button
      class="filter-btn filter-tag active"
      data-tag="all"
      aria-pressed="true"
    >All <span class="tag-count">({{ total }})</span></button>

    <!-- Show top 5 most used tags inline -->
    {{ for item of counts.slice(0, 5) }}
    {{ set weight = Math.min(5, Math.max(1, Math.ceil(item.count / 3))) }}
    <button
      class="filter-btn filter-tag weight-{{ weight }}"
      data-tag="{{ item.tag }}"
      data-count="{{ item.count }}"
      aria-pressed="false"
    >{{ item.tag }} <span class="tag-count">({{ item.count }})</span></button>
    {{ /for }}

    <!-- Dropdown for all tags -->
    {{ if counts.length > 5 }}
    <div class="tag-dropdown" id="tagDropdown">
      <button class="filter-btn tag-dropdown-trigger" id="tagDropdownTrigger" aria-expanded="false" aria-haspopup="listbox" aria-controls="tagDropdownList">
        <span>More tags</span>
        {{ comp.icon({ name: "chevron-down", size: 14 }) }}
      </button>
      <div class="tag-dropdown-panel" id="tagDropdownPanel">
        <div class="tag-dropdown-search">
          {{ comp.icon({ name: "search", size: 14, cls: "tag-dropdown-search-icon" }) }}
          <input
            type="text"
            id="tagDropdownSearch"
            class="tag-dropdown-search-input"
            placeholder="Search {{ counts.length }} tags..."
            autocomplete="off"
            aria-label="Search tags"
          >
        </div>
        <div class="tag-dropdown-list" id="tagDropdownList" role="listbox" tabindex="-1">
          {{ for item of counts }}
          <button
            class="tag-dropdown-item"
            data-tag="{{ item.tag }}"
            data-count="{{ item.count }}"
            role="option"
            aria-selected="false"
          >
            <span class="tag-dropdown-item-name">{{ item.tag }}</span>
            <span class="tag-dropdown-item-count">{{ item.count }} posts</span>
          </button>
          {{ /for }}
        </div>
        <div class="tag-dropdown-empty" id="tagDropdownEmpty" style="display: none;">
          No tags found
        </div>
      </div>
    </div>
    {{ /if }}
  </div>

  <!-- Active filters indicator -->
  <div class="active-filters" id="activeFilters" style="display: none;"
    aria-live="polite">
    <span class="active-filters-label">Filtering by:</span>
    <div class="active-filters-tags" id="activeFiltersTags"></div>
    <button class="active-filters-clear" id="clearFilters"
      aria-label="Clear all filters">
      {{ comp.icon({ name: "x", size: 14 }) }}
      Clear
    </button>
  </div>
</div>
