{{# Centralized SVG icon dictionary.

Usage: {{ comp.icon({ name: "search", size: 16, cls: "blog-search-icon" }) }}

- `name`: icon key (see branches below). Unknown names render nothing.
- `size`: optional width/height in px. Omitted → no width/height attrs
  (icon scales via CSS, exactly like the original inline markup).
- `cls`: optional class attribute.
- `style`: optional style attribute (only moon needs it).
- `a11y`: set to false only to reproduce markup that originally lacked
  aria-hidden/focusable (the ToC toggle icon). Defaults to true.

All paths/attributes are byte-identical to the inline SVGs they replace,
except `search`, which canonicalizes three serializations of the same
feather "search" glyph (single-path vs circle+line) into one. #}}
{{ if name === "search" }}
<svg{{ if cls }} class="{{ cls }}" {{ /if }} aria-hidden="true"
  focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="2" {{ if size }} width="{{ size }}" height="{{ size }}"
  {{ /if }}><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
{{ else if name === "x" }}
<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"{{ if size }} width="{{ size }}" height="{{ size }}"{{ /if }}><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
{{ else if name === "chevron-down" }}
<svg{{ if cls }} class="{{ cls }}"{{ /if }}{{ if a11y ?? true }} aria-hidden="true" focusable="false"{{ /if }} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"{{ if size }} width="{{ size }}" height="{{ size }}"{{ /if }}><path d="M19 9l-7 7-7-7"/></svg>
{{ else if name === "chevron-left" }}
<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
{{ else if name === "chevron-right" }}
<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
{{ else if name === "bookmark" }}
<svg{{ if cls }} class="{{ cls }}"{{ /if }} aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"{{ if size }} width="{{ size }}" height="{{ size }}"{{ /if }}><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
{{ else if name === "archive" }}
<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"{{ if size }} width="{{ size }}" height="{{ size }}"{{ /if }}><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
{{ else if name === "history" }}
<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"{{ if size }} width="{{ size }}" height="{{ size }}"{{ /if }}><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
{{ else if name === "arrow-up" }}
