---
layout: layouts/base.vto
title: Certifications - Marwan Ayman Shawky
description: AWS, Linux Foundation, and Huawei cloud certifications
---

<div class="container">
  <section class="section">
    {{ comp.page_header({ title: "Certifications" }) }}
    <p class="page-sub">AWS, Linux Foundation, Huawei — the paper trail.</p>

    <div id="pagination-container">
      {{ for cert of certifications }}
      <div class="e" data-pagination-item>
        <div>
          <div class="t">{{ cert.title }}</div>
          <div class="m cert-meta"><span class="chip">{{ cert.issuer }}</span>{{ if cert.expiryDate }}<span class="chip">Expires {{ cert.expiryDate }}</span>{{ /if }}{{ if cert.credentialId }}<span class="chip">ID {{ cert.credentialId }}</span>{{ /if }}</div>
        </div>
        <div class="d">{{ cert.date }}</div>
      </div>
      {{ /for }}
    </div>
  </section>
</div>
