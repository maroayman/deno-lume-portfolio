---
layout: layouts/base.vto
title: Certifications - Marwan Ayman Shawky
description: AWS, Linux Foundation, and Huawei cloud certifications
---

<div class="container">
  <section class="section">
    <p class="back-link">
      <a href="/"><span aria-hidden="true">←</span> Back</a>
    </p>

    <div class="shead">
      <h1 class="page-title">Certifications</h1><span class="rule"></span><span class="ar" dir="rtl" lang="ar">الشهادات</span>
    </div>
    <p class="page-sub">AWS, Linux Foundation, Huawei — the paper trail.</p>

    <div class="certifications-grid" id="pagination-container">
      {{ for cert of certifications }}
      <div class="card cert-card" data-pagination-item>
        <div class="cert-content">
          <h3 class="cert-title">{{ cert.title }}</h3>
          <p class="cert-issuer">{{ cert.issuer }}</p>
          <div class="cert-meta">
            <span>Issued: {{ cert.date }}</span>
            {{ if cert.expiryDate }}
            <span>Expires: {{ cert.expiryDate }}</span>
            {{ /if }}
          </div>
          {{ if cert.credentialId }}
          <p class="cert-credential">ID: {{ cert.credentialId }}</p>
          {{ /if }}
        </div>
      </div>
      {{ /for }}
    </div>
  </section>
</div>
